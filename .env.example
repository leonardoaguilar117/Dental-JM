# Copia a .env (local) o configúralas en Render > Environment
# Obligatoria en producción: valor aleatorio de al menos 32 caracteres
SECRET_KEY=cambia-esta-clave
# Datos iniciales si la base está vacía: demo (demostración completa) · inicial (doctores + 4 pacientes) · ninguno
# Vacío: "demo" en local e "inicial" en producción
SEED=
TZ_CONSULTORIO=America/Mexico_City
WHATSAPP_COUNTRY_CODE=52
EXPIRY_ALERT_DAYS=60
REMINDER_WINDOW_DAYS=7
# Vacío = SQLite local en ./data/crm_dental.db. Obligatoria en producción (PostgreSQL de Render)
DATABASE_URL=
# JSON completo de la cuenta de servicio (una sola línea) para sincronizar con Google Calendar
GOOGLE_SERVICE_ACCOUNT_JSON=

# Seguridad: ENVIRONMENT=production activa cookies solo-HTTPS y oculta /api/docs (Render ya lo hace solo)
ENVIRONMENT=
HTTPS_ONLY=
# Contraseña inicial de jimena y carlos. Vacío: demo123 en local; en producción es obligatoria (mín. 10 caracteres)
DEMO_PASSWORD=
# Datos del establecimiento que exige la NOM-004-SSA3-2012 en historia clínica y consentimientos
CLINIC_NAME=Consultorio Dental JM
CLINIC_RAZON_SOCIAL=
CLINIC_ADDRESS=
CLINIC_CITY=Ciudad de México
CLINIC_PHONE=
CLINIC_LICENCIA=
CLINIC_RESPONSABLE=
CLINIC_RESPONSABLE_CEDULA=
